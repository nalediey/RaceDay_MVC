@{
    ViewData["Title"] = "Participant Dashboard";
}

@Html.Partial("_dashnavs")

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="dashboard-page">

    <!-- Dashboard Header -->
    <div class="dashboard-header participant-header">
        <div class="dashboard-header-content">
            <h1>Participant <span>Dashboard</span></h1>
            <p>Welcome back! Ready to chase your next finish line?</p>
        </div>
        <a asp-action="BrowseEvents" class="primary-btn">
            <i class="fa-solid fa-magnifying-glass"></i> Find an Event
        </a>
    </div>

    <div class="dashboard-container">

        <!-- Summary Cards -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-ticket"></i></div>
                <div class="stat-info">
                    <h2>0</h2>
                    <p>My Enrolments</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-medal"></i></div>
                <div class="stat-info">
                    <h2>0</h2>
                    <p>Results Recorded</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fa-solid fa-person-running"></i></div>
                <div class="stat-info">
                    <h2>0</h2>
                    <p>Total Distance (KM)</p>
                </div>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="participant-dashboard-grid">

            <!-- Upcoming Enrolments Section -->
            <div class="participant-section">
                <div class="section-header">
                    <h2 class="section-title">My Upcoming Races</h2>
                </div>

                <div class="no-events">
                    <i class="fa-regular fa-calendar-xmark" style="font-size: 40px; color: #d5dbe5; margin-bottom: 15px;"></i>
                    <p>You haven't enrolled in any upcoming events yet.</p>
                    <a asp-action="BrowseEvents" class="primary-btn">Browse Events</a>
                </div>
            </div>

            <!-- Quick Links Section -->
            <div class="participant-section">
                <h2 class="section-title">Quick Actions</h2>

                <div class="quick-links">
                    <a asp-action="MyResults" class="quick-link-card">
                        <div class="ql-icon"><i class="fa-solid fa-chart-simple"></i></div>
                        <div class="ql-text">
                            <h3>My Results</h3>
                            <p>View your past race times and positions.</p>
                        </div>
                        <i class="fa-solid fa-chevron-right ql-arrow"></i>
                    </a>

                    <a asp-action="Profile" class="quick-link-card">
                        <div class="ql-icon"><i class="fa-solid fa-user-pen"></i></div>
                        <div class="ql-text">
                            <h3>Profile Settings</h3>
                            <p>Update your personal information.</p>
                        </div>
                        <i class="fa-solid fa-chevron-right ql-arrow"></i>
                    </a>

                    <a asp-action="MyEnrolments" class="quick-link-card">
                        <div class="ql-icon"><i class="fa-solid fa-list-check"></i></div>
                        <div class="ql-text">
                            <h3>My Enrolments</h3>
                            <p>Manage the races you have entered.</p>
                        </div>
                        <i class="fa-solid fa-chevron-right ql-arrow"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>