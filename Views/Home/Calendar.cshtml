@{
    ViewData["Title"] = "Race Calendar";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<!-- Navigation -->
@Html.Partial("_navigation")


<!-- RACE CALENDAR PAGE -->
<div class="calendar-page">

    <!-- Hero Section -->
    <section class="calendar-hero">
        <p class="section-label">PLAN YOUR NEXT CHALLENGE</p>

        <h1>Race <span>Calendar</span></h1>

        <p>
            Never miss a race! Explore upcoming running, walking and cycling
            events happening across South Africa. Find your next challenge
            and get ready to cross the finish line.
        </p>

        <a href="@Url.Action("Events", "Home")" class="calendar-btn">
            Explore All Events
        </a>
    </section>


    <!-- Calendar Introduction -->
    <section class="calendar-intro">

        <h2>Upcoming Race Events</h2>

        <p>
            Plan ahead, choose your event and start preparing for race day.
        </p>

    </section>


    <!-- Event Calendar Cards -->
    <section class="calendar-container">

        <!-- Event 1 -->
        <div class="calendar-card">

            <div class="calendar-date">
                <span class="month">NOV</span>
                <h2>14</h2>
                <span class="day">Saturday</span>
            </div>

            <div class="calendar-details">

                <span class="event-category running">Running</span>

                <h3>Johannesburg City Run</h3>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Johannesburg, Gauteng
                </p>

                <p>
                    <i class="fa-solid fa-clock"></i>
                    07:00 AM
                </p>

                <p>
                    Join other runners for an exciting city running experience.
                </p>

                <a href="@Url.Action("Events", "Home")" class="calendar-entry">
                    View Event
                </a>

            </div>
        </div>


        <!-- Event 2 -->
        <div class="calendar-card">

            <div class="calendar-date cycling-date">
                <span class="month">NOV</span>
                <h2>21</h2>
                <span class="day">Saturday</span>
            </div>

            <div class="calendar-details">

                <span class="event-category cycling">Cycling</span>

                <h3>Cape Town Cycling Challenge</h3>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Cape Town, Western Cape
                </p>

                <p>
                    <i class="fa-solid fa-clock"></i>
                    08:00 AM
                </p>

                <p>
                    Experience an exciting cycling challenge with beautiful
                    Cape Town scenery.
                </p>

                <a href="@Url.Action("Events", "Home")" class="calendar-entry">
                    View Event
                </a>

            </div>
        </div>


        <!-- Event 3 -->
        <div class="calendar-card">

            <div class="calendar-date walking-date">
                <span class="month">NOV</span>
                <h2>28</h2>
                <span class="day">Saturday</span>
            </div>

            <div class="calendar-details">

                <span class="event-category walking">Walking</span>

                <h3>Community Charity Walk</h3>

                <p>
                    <i class="fa-solid fa-location-dot"></i>
                    Soweto, Gauteng
                </p>

                <p>
                    <i class="fa-solid fa-clock"></i>
                    09:00 AM
                </p>

                <p>
                    Take part in a fun community walk while supporting a good cause.
                </p>

                <a href="@Url.Action("Events", "Home")" class="calendar-entry">
                    View Event
                </a>

            </div>
        </div>

    </section>


    <!-- Calendar Information -->
    <section class="calendar-message">

        <i class="fa-solid fa-flag-checkered"></i>

        <h2>Ready for Your Next Race?</h2>

        <p>
            Every race is an opportunity to challenge yourself, improve your
            performance and achieve something amazing.
        </p>

        <a href="@Url.Action("Register", "Home")" class="calendar-btn">
            Join RaceDay Today
        </a>

    </section>

</div>