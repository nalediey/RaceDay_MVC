@{
    ViewData["Title"] = "Register";
}
@model RaceDay_MVC.Models.RegisterDto

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
@Html.Partial("_navigation")

<div class="auth-page">
    <div class="auth-container register-container">
        <div class="auth-image register-image">
            <div class="auth-image-content">
                <h1>JOIN RACEDAY!</h1>
                <p>Be part of South Africa's active community.</p>
            </div>
        </div>

        <div class="auth-form register-form">
            <span class="auth-label">CREATE YOUR ACCOUNT</span>
            <h2>Register with RaceDay</h2>

            <form asp-controller="Home" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="register-inputs">
                    <div class="auth-input-group">
                        <label>First Name</label>
                        <input type="text" name="first_name" placeholder="Enter first name" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Last Name</label>
                        <input type="text" name="last_name" placeholder="Enter last name" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Email Address</label>
                        <input type="email" name="Email" placeholder="Enter email address" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Phone Number</label>
                        <input type="tel" name="PhoneNUmber" placeholder="e.g. 0712345678" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Password</label>
                        <input type="password" name="Password" placeholder="Create a password" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Confirm Password</label>
                        <!-- Note the spelling to match your API -->
                        <input type="password" name="Comfirmpassword" placeholder="Confirm your password" required />
                    </div>

                    <div class="auth-input-group">
                        <label>Account Type</label>
                        <!-- Must match exactly "Organiser" or "Participant" -->
                        <select name="role" required>
                            <option value="">Select account type</option>
                            <option value="Participant">Participant</option>
                            <option value="Organiser">Event Organiser</option>
                        </select>
                    </div>
                </div>

                <button type="submit" class="auth-submit">Create My Account</button>
            </form>

            <p class="auth-switch">
                Already have an account?
                <a asp-controller="Home" asp-action="Login">Login here</a>
            </p>
        </div>
    </div>
</div>